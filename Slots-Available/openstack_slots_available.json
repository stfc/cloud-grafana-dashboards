          "id": 4,
          "title": "L* flavors",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "prod_cloud_influx"
                      },
                      "spec": {
                        "alias": "$tag_flavor",
                        "groupBy": [
                          {
                            "params": [
                              "flavor"
                            ],
                            "type": "tag"
                          }
                        ],
                        "measurement": "SlotsAvailable",
                        "orderByTime": "ASC",
                        "policy": "default",
                        "query": "SELECT last(\"SlotsAvailable\") FROM \"SlotsAvailable\" WHERE (\"instance\" =~  /^${Instance:text}$/  AND \"flavor\" !~ /.*test.*/ AND \"flavor\" !~ /.*temp.*/ AND \"flavor\" =~ /^l.*/) AND $timeFilter GROUP BY \"flavor\"",
                        "rawQuery": true,
                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "SlotsAvailable"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "last"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "flavor",
                            "operator": "!~",
                            "value": "/.*test.*/"
                          },
                          {
                            "condition": "AND",
                            "key": "flavor",
                            "operator": "!~",
                            "value": "/.*temp.*/"
                          },
                          {
                            "condition": "AND",
                            "key": "flavor",
                            "operator": "=~",
                            "value": "/^l.*/"
                          }
                        ]
